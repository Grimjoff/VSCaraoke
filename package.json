{
  "name": "vscaraoke",
  "displayName": "VSCaraoke",
  "description": "Synced lyrics for what is playing on Spotify, with dancing pixel sproutlings.",
  "publisher": "grimjoff",
  "repository": {
    "type": "git",
    "url": "https://github.com/Grimjoff/VSCaraoke.git"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "vscaraoke-panel",
          "title": "VSCaraoke",
          "icon": "media/music.svg"
        }
      ]
    },
    "views": {
      "vscaraoke-panel": [
        {
          "type": "webview",
          "id": "vscaraoke.lyricsView",
          "name": "Lyrics"
        }
      ]
    },
    "commands": [
      {
        "command": "vscaraoke.show",
        "title": "Show Lyrics Panel",
        "category": "VSCaraoke"
      },
      {
        "command": "vscaraoke.signIn",
        "title": "Sign in to Spotify",
        "category": "VSCaraoke"
      },
      {
        "command": "vscaraoke.signOut",
        "title": "Sign out of Spotify",
        "category": "VSCaraoke"
      },
      {
        "command": "vscaraoke.searchLyrics",
        "title": "Search Lyrics Manually",
        "category": "VSCaraoke"
      },
      {
        "command": "vscaraoke.reloadLyrics",
        "title": "Reload Lyrics",
        "category": "VSCaraoke"
      },
      {
        "command": "vscaraoke.lyricsEarlier",
        "title": "Show Lyrics Earlier (-250ms)",
        "category": "VSCaraoke"
      },
      {
        "command": "vscaraoke.lyricsLater",
        "title": "Show Lyrics Later (+250ms)",
        "category": "VSCaraoke"
      },
      {
        "command": "vscaraoke.tapTempo",
        "title": "Tap Tempo",
        "category": "VSCaraoke"
      },
      {
        "command": "vscaraoke.openSettings",
        "title": "Open Settings",
        "category": "VSCaraoke",
        "icon": "$(gear)"
      }
    ],
    "configuration": {
      "title": "VSCaraoke",
      "properties": {
        "vscaraoke.spotifyClientId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Client ID of your Spotify developer app. Add the URL from `#vscaraoke.redirectUri#` (default `http://127.0.0.1:43821/callback`) as a Redirect URI in the app settings."
        },
        "vscaraoke.redirectUri": {
          "type": "string",
          "default": "http://127.0.0.1:43821/callback",
          "markdownDescription": "Callback URL for the Spotify sign-in. Must be `http://127.0.0.1:<port>/<path>` (or `[::1]`) and match a Redirect URI in your Spotify app **exactly**. Change the port if 43821 is taken on your machine."
        },
        "vscaraoke.creatureCount": {
          "type": "number",
          "default": 6,
          "minimum": 0,
          "maximum": 12,
          "description": "Number of dancing creatures on the stage."
        },
        "vscaraoke.showVisualizer": {
          "type": "boolean",
          "default": true,
          "description": "Show the beat-driven bar visualizer behind the sproutlings."
        },
        "vscaraoke.lyricsOffsetMs": {
          "type": "number",
          "default": 0,
          "description": "Global lyrics offset in milliseconds. Positive values show lyrics later."
        },
        "vscaraoke.chaos": {
          "type": "string",
          "enum": [
            "calm",
            "lively",
            "chaos"
          ],
          "default": "lively",
          "enumDescriptions": [
            "Gentle dancing, few particles, no bugs.",
            "Wandering, leaps, the odd stumble, confetti, a couple of bugs.",
            "Everything, all the time. Screen shake included."
          ],
          "description": "How messy the stage gets."
        },
        "vscaraoke.species": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sproutling",
              "capling",
              "wisp",
              "beepbox",
              "dribble"
            ]
          },
          "default": [],
          "uniqueItems": true,
          "description": "Which creatures may appear. Empty = all of them."
        },
        "vscaraoke.stageHeight": {
          "type": "number",
          "default": 112,
          "minimum": 48,
          "maximum": 240,
          "description": "Height of the creature stage in pixels."
        },
        "vscaraoke.lineFill": {
          "type": "string",
          "enum": [
            "instant",
            "sweep"
          ],
          "default": "instant",
          "enumDescriptions": [
            "The current line lights up in the highlight color all at once.",
            "The highlight color fills across the line as it is sung (word by word when the lyrics have word timings)."
          ],
          "description": "How the current lyric line is highlighted."
        },
        "vscaraoke.demoWhenIdle": {
          "type": "boolean",
          "default": true,
          "description": "When Spotify is not playing anything, the crew performs a (silent) demo song with its own lyrics. Use the REST button in the panel to let them nap."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "vscaraoke.openSettings",
          "when": "view == vscaraoke.lyricsView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "~1.107.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}